#!/bin/sh
# Docker の API を mutual TLS で開けて dockerd を起動する (busybox init が respawn する).
# 鍵は host が起動のたびに 2 つ目の disk (tar) で渡す. guest の disk には書かない.

set -eu

cred_dev=/dev/vdb
tls_dir=/run/padserver/tls
port=2376

die() {
	echo "start-dockerd: $*" >&2
	sleep 5
	exit 1
}

# 以前の版が disk に作った鍵 (client の秘密鍵を含む) を消す.
rm -rf /var/lib/padserver/tls

[ -b "$cred_dev" ] || die "the credentials disk $cred_dev is missing."
mkdir -p "$tls_dir"
mountpoint -q "$tls_dir" || mount -t tmpfs -o mode=700,size=1m none "$tls_dir"
tar -xf "$cred_dev" -C "$tls_dir" ca.pem server.pem server-key.pem || die "could not read the credentials from $cred_dev."
for name in ca.pem server.pem server-key.pem; do
	[ -s "$tls_dir/$name" ] || die "$name is missing from the credentials."
done
chmod 600 "$tls_dir"/*.pem

exec dockerd \
	--host unix:///var/run/docker.sock \
	--host "tcp://0.0.0.0:$port" \
	--tlsverify \
	--tlscacert "$tls_dir/ca.pem" \
	--tlscert "$tls_dir/server.pem" \
	--tlskey "$tls_dir/server-key.pem"
