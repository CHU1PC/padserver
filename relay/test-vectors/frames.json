    {
      "name": "req-head-post",
      "description": "本文のある POST. path に query と percent-encoding を含む. hasBody が true なので, ReqBody と ReqEnd が続く",
      "frame": {
        "type": "ReqHead",
        "typeValue": 1,
        "id": 2,
        "payload": {
          "json": {
            "method": "POST",
            "path": "/upload?name=a%20b",
            "host": "www.example.com",
            "headers": [
              [
                "content-type",
                "text/plain"
              ],
              [
                "content-length",
                "11"
              ]
            ],
            "hasBody": true
          }
        }
      },
      "hex": ""
    },
