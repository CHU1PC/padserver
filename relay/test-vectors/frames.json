    {
      "name": "req-head-get",
      "description": "本文の無い GET. hasBody が false なので, ReqBody と ReqEnd は続かない",
      "frame": {
        "type": "ReqHead",
        "typeValue": 1,
        "id": 1,
        "payload": {
          "json": {
            "method": "GET",
            "path": "/index.html",
            "host": "example.com",
            "headers": [
              [
                "accept",
                "text/html"
              ],
              [
                "user-agent",
                "example-agent"
              ]
            ],
            "hasBody": false
          }
        }
      },
      "hex": "01000000017b226d6574686f64223a22474554222c2270617468223a222f696e6465782e68746d6c222c22686f7374223a226578616d706c652e636f6d222c2268656164657273223a5b5b22616363657074222c22746578742f68746d6c225d2c5b22757365722d6167656e74222c226578616d706c652d6167656e74225d5d2c22686173426f6479223a66616c73657d"
